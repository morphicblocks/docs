# Copy to `.env` and fill in your own values. Every switchable value of the
# docs site lives here. On Cloudflare Pages, set these as build-time
# environment variables. These are placeholders; real values go in `.env`.

PUBLIC_SITE_NAME="Example Project"
PUBLIC_SITE_URL="https://docs.example.com"
PUBLIC_SITE_DESCRIPTION="Documentation for your project."

PUBLIC_NPM_PACKAGE="your-package"
PUBLIC_NPM_URL="https://www.npmjs.com/package/your-package"
PUBLIC_GITHUB_URL="https://github.com/your-org/your-repo"

PUBLIC_LANDING_URL="https://example.com"
PUBLIC_PLAYGROUND_URL="https://playground.example.com"

PUBLIC_UNIVERSITY="Your Organization"
PUBLIC_UNIVERSITY_URL="https://example.org/"

# Legal pages shown in the footer. The base variable is used by every language;
# add the _EN override only when a translated page exists.
PUBLIC_IMPRINT_URL="/imprint"
PUBLIC_IMPRINT_URL_EN=""
PUBLIC_PRIVACY_URL="/privacy"
PUBLIC_PRIVACY_URL_EN=""
PUBLIC_DISCLAIMER_URL="/disclaimer"
PUBLIC_DISCLAIMER_URL_EN=""

# ── Deployment (Docker + Traefik) ──────────────────────────────────────
# Read by docker compose, not by the dev server. Everything else about the
# deployment is identical for every clone and is written directly in
# docker-compose.yaml / docker-compose.prod.yaml.

# Hostname Traefik should route to this container.
DEPLOY_DOMAIN="docs.example.com"

# Only when the build host reaches the internet through a proxy.
HTTP_PROXY=""
HTTPS_PROXY=""
NO_PROXY=""
