# Copy to .env and adjust. Every switchable value of the docs site lives here.
# On Cloudflare Pages, set these as build-time environment variables.

PUBLIC_SITE_NAME="Morphic Blocks"
PUBLIC_SITE_URL="https://docs.morphicblocks.com"
PUBLIC_SITE_DESCRIPTION="Documentation for Morphic Blocks, an open-source TypeScript library built on Google Blockly that renders one block model in multiple developer-defined modes."

PUBLIC_NPM_PACKAGE="morphic-blocks"
PUBLIC_NPM_URL="https://www.npmjs.com/package/morphic-blocks"
PUBLIC_GITHUB_URL="https://github.com/morphicblocks/morphic-blocks"

PUBLIC_LANDING_URL="https://morphicblocks.com"
PUBLIC_PLAYGROUND_URL="https://playground.morphicblocks.com"

PUBLIC_UNIVERSITY="Leibniz University Hannover"
PUBLIC_UNIVERSITY_URL="https://www.uni-hannover.de/"
